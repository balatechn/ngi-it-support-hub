# ─────────────────────────────────────────────────────────────
# Microsoft Azure AD / Entra ID (required for SSO)
# Register an app at https://portal.azure.com → App registrations
# ─────────────────────────────────────────────────────────────
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-tenant-id

# ─────────────────────────────────────────────────────────────
# NextAuth.js
# Generate with: openssl rand -base64 32
# NEXTAUTH_URL must match your deployment URL
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Demo mode (set to "true" to bypass auth for testing)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=false

# ─────────────────────────────────────────────────────────────
# Optional: Microsoft Graph API (for Teams integration)
# ─────────────────────────────────────────────────────────────
MICROSOFT_GRAPH_SCOPE=https://graph.microsoft.com/.default

# ─────────────────────────────────────────────────────────────
# Optional: Power BI Embed (for analytics dashboard)
# ─────────────────────────────────────────────────────────────
POWER_BI_WORKSPACE_ID=your-powerbi-workspace-id
POWER_BI_REPORT_ID=your-powerbi-report-id

# ─────────────────────────────────────────────────────────────
# Google Gemini AI (for AI Assistant at /chat)
# Get key at https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─────────────────────────────────────────────────────────────
# Ticket server (Coolify — keeps tickets on persistent volume)
# Leave TICKETS_API_URL blank to use local filesystem in dev
# ─────────────────────────────────────────────────────────────
TICKETS_API_URL=http://your-coolify-server-ip:4000
TICKET_API_KEY=your-shared-secret-here
